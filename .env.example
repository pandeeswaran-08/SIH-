# ==============================================================================
# AICTE AI-Powered Application Validation Platform - Environment Configuration
# ==============================================================================

# Application & Environment
APP_NAME=AICTE AI-Powered Application Validation Platform
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & Cryptography
# Generate a strong 256-bit random secret in production
JWT_SECRET_KEY=aicte_regulatory_decision_support_super_secret_key_2025_prod_random_hash
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: Zero-dependency thread-safe SQLite for local development & demonstration
# DATABASE_URL=sqlite:///./backend/data/aicte_validation.db
# PostgreSQL Production Connection:
# DATABASE_URL=postgresql://aicte_user:aicte_secure_pass@localhost:5432/aicte_validation

# Private Document Storage Configuration
# Default: LOCAL (private disk filesystem with SHA-256 integrity fingerprints)
STORAGE_BACKEND=LOCAL
STORAGE_LOCAL_DIR=./storage_data/documents

# Optional MinIO Object Storage Adapter
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=aicte-documents
MINIO_SECURE=False

# Low-Resource AI Engine & Execution Controls
# Defaults configured for Intel Core i7 8th Gen, 8GB RAM, NVIDIA MX130 2GB VRAM
INFERENCE_DEVICE=cpu
MAX_CONCURRENT_VALIDATION_JOBS=2
MAX_PDF_PAGES=15
IMAGE_BLUR_THRESHOLD=0.65
ENABLE_YOLO_INFRASTRUCTURE=False
ENABLE_LAYOUTLM=False
RISK_CONSOLIDATION_MODE=single_root_cause

# External Issuing Authority Integrations (Sandboxed Stubs)
LAND_REGISTRY_API_URL=https://synthetic-api.landrecords.gov.in/v1
UNIVERSITY_REGISTRY_API_URL=https://synthetic-api.universityaffiliation.ac.in/v1
FIRE_SAFETY_API_URL=https://synthetic-api.firesafety.gov.in/v1
EXTERNAL_API_TIMEOUT_SECONDS=5
